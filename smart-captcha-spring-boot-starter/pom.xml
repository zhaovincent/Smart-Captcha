<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.localtool</groupId>
        <artifactId>smart-captcha-parent</artifactId>
        <version>1.8.0</version>
    </parent>

    <artifactId>smart-captcha-spring-boot-starter</artifactId>
    <name>SmartCaptcha Spring Boot Starter</name>
    <description>Spring Boot 3 auto-configuration for SmartCaptcha: properties binding, @RequireCaptcha interceptor, Redis / Redisson stores</description>

    <dependencies>
        <!-- 1) 内核 -->
        <dependency>
            <groupId>cn.localtool</groupId>
            <artifactId>smart-captcha-core</artifactId>
        </dependency>

        <!-- 2) Spring Boot 自动装配基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 3) Web 相关（拦截器 / CORS）：引入 web 时才装配 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 4) Redis 存储（StringRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 5) Redisson 存储 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 6) Redis 存储的答案序列化（拦截器不再输出 JSON，响应体由接入方决定） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.localtool</groupId>
            <artifactId>smart-captcha-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 安装时生成扁平化 POM（不引用父 POM），供外部项目直接依赖 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
