<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.x（Jakarta EE 命名空间），仅用于依赖版本管理 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>cn.localtool</groupId>
    <artifactId>smart-captcha-parent</artifactId>
    <version>1.5.0</version>
    <packaging>pom</packaging>

    <name>SmartCaptcha</name>
    <description>Behavior captcha (slider / click word / rotate): pure Java core, Spring Boot starter and demo server</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <!-- 1) 纯 Java 内核：零第三方依赖，不依赖 Spring -->
        <module>smart-captcha-core</module>
        <!-- 2) Spring Boot starter：自动装配 + 拦截器 + Redis / Redisson 存储 -->
        <module>smart-captcha-spring-boot-starter</module>
        <!-- 3) 开箱即用的 Spring Boot 服务：REST 接口 + 演示页面后端 -->
        <module>smart-captcha-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <redisson.version>3.52.0</redisson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.localtool</groupId>
                <artifactId>smart-captcha-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.localtool</groupId>
                <artifactId>smart-captcha-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  把安装到仓库的 POM 扁平化：去掉 <parent> 引用、把继承来的版本号写成字面量。
                  这样别的项目只依赖 starter / core 即可，不必解析本聚合父 POM
                  （否则 IDEA 里可能出现 Unresolved dependency: cn.localtool:smart-captcha-parent:jar:&lt;version&gt;）。
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.7.3</version>
                    <configuration>
                        <flattenMode>defaults</flattenMode>
                        <updatePomFile>true</updatePomFile>
                        <flattenedPomFilename>.flattened-pom.xml</flattenedPomFilename>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
